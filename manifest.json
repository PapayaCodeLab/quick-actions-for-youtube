{
  "manifest_version": 3,
  "name": "Quick Actions for YouTube – History, Speed, Screenshots & Thumbnails",
  "short_name": "Quick Actions",
  "version": "1.1.0",
  "description": "One-click history removal, pinned playlists, speed controls, screenshots and thumbnail downloads for YouTube. 100% local.",
  "author": "Papaya Code",
  "homepage_url": "https://github.com/PapayaCodeLab/quick-actions-for-youtube",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons.json"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "emoji-data.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
